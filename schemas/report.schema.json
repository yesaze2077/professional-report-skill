{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Professional Report IR v3.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "sources",
    "metrics",
    "summary",
    "sections",
    "actions",
    "checks"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "data_as_of": {
          "type": "string",
          "minLength": 1
        },
        "main_question": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "const": "zh-CN"
        },
        "synthetic": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "final",
            "partial"
          ]
        },
        "depth": {
          "enum": [
            "brief",
            "standard",
            "comprehensive"
          ]
        },
        "format_mode": {
          "enum": ["brief", "full"]
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "report_date": {
          "type": "string",
          "minLength": 1
        },
        "confidentiality": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "edition",
        "period",
        "data_as_of",
        "main_question",
        "scope",
        "language",
        "synthetic",
        "status"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "period",
          "locator",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "synthetic",
              "observed",
              "calculated",
              "estimated",
              "missing",
              "pending",
              "not_applicable"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "value",
          "unit",
          "status",
          "source_id"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "bottom_line": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "text",
              "source_ids"
            ],
            "additionalProperties": false
          }
        },
        "next_step": {
          "type": "string",
          "minLength": 1
        },
        "critical_limit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bottom_line",
        "findings",
        "next_step",
        "critical_limit"
      ],
      "additionalProperties": false
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "suffix": {
            "type": "string"
          },
          "comparison": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "label",
          "metric_id",
          "scale",
          "decimals",
          "suffix",
          "comparison"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "eyebrow": {
            "type": "string",
            "minLength": 1
          },
          "headline": {
            "type": "string",
            "minLength": 1
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "claim_type": {
            "enum": [
              "fact",
              "calculation",
              "interpretation",
              "hypothesis",
              "causal",
              "recommendation"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "limitation": {
            "type": "string",
            "minLength": 1
          },
          "implication": {
            "type": "string",
            "minLength": 1
          },
          "chart": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "hbar",
                  "dumbbell",
                  "waterfall",
                  "line"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "period": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "metric_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "before": {
                      "type": "string",
                      "minLength": 1
                    },
                    "after": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "enum": [
                        "start",
                        "delta",
                        "total"
                      ]
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "series_labels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2,
                "maxItems": 2
              },
              "y_min": {
                "type": "number"
              },
              "y_max": {
                "type": "number"
              }
            },
            "required": [
              "type",
              "title",
              "unit",
              "period",
              "alt",
              "source_ids",
              "scale",
              "decimals",
              "rows"
            ],
            "additionalProperties": false
          },
          "table": {
            "type": "object",
            "properties": {
              "headers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 6
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "metric_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "scale": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "decimals": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4
                          },
                          "suffix": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "metric_id",
                          "scale",
                          "decimals",
                          "suffix"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              }
            },
            "required": [
              "headers",
              "rows"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "eyebrow",
          "headline",
          "paragraphs",
          "claim_type",
          "source_ids",
          "limitation",
          "implication"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "timing": {
            "type": "string",
            "minLength": 1
          },
          "success": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "string",
            "minLength": 1
          },
          "related_sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "proposed",
              "approved"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "rationale",
          "owner",
          "timing",
          "success",
          "gate",
          "dependencies",
          "related_sections",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "enum": [
              "sum",
              "difference",
              "ratio",
              "relative_change",
              "pp_change",
              "multiply"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "result_metric": {
            "type": "string",
            "minLength": 1
          },
          "tolerance": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "op",
          "inputs",
          "result_metric",
          "tolerance"
        ],
        "additionalProperties": false
      }
    },
    "composition": {
      "type": "object",
      "required": [
        "pages"
      ],
      "additionalProperties": false,
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "chapter",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "summary",
                  "toc",
                  "content",
                  "actions",
                  "sources",
                  "cover",
                  "back",
                  "visual"
                ]
              },
              "chapter": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "section_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "action_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "visual_kind": {
                "enum": ["synthetic_ui", "process"]
              },
              "visual_title": {
                "type": "string",
                "minLength": 1
              },
              "visual_note": {
                "type": "string",
                "minLength": 1
              },
              "evidence_source_id": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "items": {"type": "string", "minLength": 1}
              },
              "readouts": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value", "label"],
                  "properties": {
                    "value": {"type": "string", "minLength": 1},
                    "label": {"type": "string", "minLength": 1}
                  }
                }
              },
              "readout_summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "domain",
          "status",
          "section_ids",
          "explanation",
          "action_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "covered",
              "partial",
              "missing",
              "not_applicable"
            ]
          },
          "section_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "action_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$defs": {}
}
